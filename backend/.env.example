# =============================================================================
# SECURE-TEAM WORKSPACE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xdw26xa.mongodb.net/secure_team_workspace?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security Secrets (Must be at least 64 characters in production)
JWT_ACCESS_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=GENERATE_ANOTHER_STRONG_RANDOM_SECRET_MIN_64_CHARS

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Facebook OAuth Credentials
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET

# =============================================================================
# SMTP & PROJECT INVITATION EMAIL CONFIGURATION (Nodemailer)
# =============================================================================
# Supports both SMTP_* and EMAIL_* conventions.
# For Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter the 16-character password below (without spaces) as SMTP_PASS.
# 4. Use Port 465 with SMTP_SECURE=true for direct SSL (recommended for cloud servers).
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM="Secure-Team Workspace" <your_email@gmail.com>

# Legacy / Alternative aliases (also supported):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# File Storage Provider
STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads
STORAGE_REGION=us-east-1
