# =============================================================================
# SECURE-TEAM WORKSPACE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xdw26xa.mongodb.net/secure_team_workspace?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security Secrets (Must be at least 64 characters in production)
JWT_ACCESS_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=GENERATE_ANOTHER_STRONG_RANDOM_SECRET_MIN_64_CHARS

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Facebook OAuth Credentials
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET

# =============================================================================
# EMAIL DELIVERY CONFIGURATION (Gmail SMTP & Gmail API HTTPS)
# =============================================================================
# Select provider: 'smtp' or 'gmail_api' (default: auto-detected)
# EMAIL_PROVIDER=smtp

# --- OPTION A: GMAIL SMTP (Recommended for Local Development & Render Paid) ---
# 1. Enable 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter the 16-character password below (spaces are automatically stripped).
# 4. Uses Port 465 with SMTP_SECURE=true for direct SSL connection.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM="Secure-Team Workspace" <your_email@gmail.com>

# Legacy / Alternative aliases (also supported):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# --- OPTION B: GMAIL API OVER HTTPS (Recommended for Render Free Plan) --------
# NOTE: Render Free Web Services block outbound TCP ports 25, 465, and 587.
# The Gmail API uses standard HTTPS (port 443) which is fully supported on Render Free.
# 1. Enable the Gmail API in Google Cloud Console: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 2. Create an OAuth 2.0 Client ID (Web Application) with redirect URI https://developers.google.com/oauthplayground
# 3. Authorize the scope: https://www.googleapis.com/auth/gmail.send
# 4. Exchange authorization code for a Refresh Token and set the variables below:
# EMAIL_PROVIDER=gmail_api
# GMAIL_API_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GMAIL_API_CLIENT_SECRET=your_google_oauth_client_secret
# GMAIL_API_REFRESH_TOKEN=your_google_oauth_refresh_token
# GMAIL_API_USER=your_email@gmail.com

# File Storage Provider
STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads
STORAGE_REGION=us-east-1
